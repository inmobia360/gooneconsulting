{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goonce.example/schemas/sector-summary.v0.1.schema.json",
  "title": "Orientación de soluciones por sector",
  "description": "Contrato documental; no es un endpoint ni supone que exista un runtime.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "status", "sector", "claims", "processAreas", "frictions", "opportunities", "qualityReview", "summary", "limitations", "evidence"],
  "properties": {
    "version": { "const": "0.1" },
    "status": { "enum": ["completed", "limited", "blocked"] },
    "sector": { "type": "string", "minLength": 1, "maxLength": 80 },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "text", "confidence", "evidenceRefs"],
        "properties": {
          "id": { "type": "string" },
          "type": { "enum": ["fact", "inference", "recommendation"] },
          "text": { "type": "string" },
          "confidence": { "enum": ["high", "medium", "low"] },
          "reasoning": { "type": "string" },
          "evidenceRefs": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "url", "publisher", "accessedAt", "supports"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "publisher": { "type": "string" },
          "publishedAt": { "type": ["string", "null"], "format": "date" },
          "accessedAt": { "type": "string", "format": "date" },
          "supports": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
        }
      }
    },
    "processAreas": { "type": "array", "items": { "type": "string" } },
    "frictions": { "type": "array", "items": { "type": "string" } },
    "opportunities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["friction", "optionType", "description", "effort", "risks", "dependencies", "validation"],
        "properties": {
          "friction": { "type": "string" },
          "optionType": { "enum": ["process", "rules-automation", "ai", "human-review"] },
          "description": { "type": "string" },
          "effort": { "enum": ["low", "medium", "high", "unknown"] },
          "risks": { "type": "array", "items": { "type": "string" } },
          "dependencies": { "type": "array", "items": { "type": "string" } },
          "validation": { "type": "string" }
        }
      }
    },
    "qualityReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "findings"],
      "properties": {
        "verdict": { "enum": ["PASS", "REVISE", "BLOCK"] },
        "findings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "summary": { "type": "string" },
    "limitations": { "type": "array", "items": { "type": "string" } }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "completed" } } },
      "then": { "properties": { "qualityReview": { "properties": { "verdict": { "const": "PASS" } } }, "evidence": { "minItems": 1 }, "claims": { "minItems": 1 } } }
    },
    {
      "if": { "properties": { "status": { "const": "blocked" } } },
      "then": { "properties": { "qualityReview": { "properties": { "verdict": { "const": "BLOCK" } } } } }
    }
  ]
}
