{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "indigo": { "$value": "#17163B", "$type": "color" },
    "violet": { "$value": "#6C4CF1", "$type": "color" },
    "lime": { "$value": "#C8F04A", "$type": "color" },
    "cream": { "$value": "#F5F1E8", "$type": "color" },
    "lavender": { "$value": "#D9D4FF", "$type": "color" },
    "danger": { "$value": "#B42318", "$type": "color", "$description": "Excepción documentada para errores técnicos; acompañar siempre de icono y texto." }
  },
  "font": {
    "display": { "$value": "Space Grotesk, system-ui, sans-serif", "$type": "fontFamily" },
    "body": { "$value": "Inter, system-ui, sans-serif", "$type": "fontFamily" }
  },
  "radius": {
    "sm": { "$value": "8px", "$type": "borderRadius" },
    "md": { "$value": "14px", "$type": "borderRadius" },
    "lg": { "$value": "24px", "$type": "borderRadius" }
  },
  "motion": {
    "standard": { "$value": "180ms ease", "$type": "duration" }
  }
}
